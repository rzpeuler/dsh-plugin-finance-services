* text=auto eol=lf
# Upstream resource bytes (including intentional Markdown hard breaks) remain hash-locked.
assets/source-archive/** -text -whitespace
assets/skills/** -text -whitespace
assets/role-skills/** -text -whitespace
assets/source-snapshot.zip -text
# Native TAP assertion diagnostics are immutable evidence, including whitespace and CRLF.
acceptance/*.tap -text -whitespace
