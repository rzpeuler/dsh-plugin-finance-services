{
  "name": "@local/dsh-financial-services",
  "version": "0.2.2",
  "description": "Financial Services for DeepSeek Harness: native workspace binding and staged, audited migration of financial workflows.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.1-rc.5"
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./role": "./lib/role.js",
    "./role-numeric-1": "./lib/role-numeric-1.js",
    "./role-numeric-1/locale/*.json": "./locale/role/*.json",
    "./role-numeric-1/icon": "./icon.svg",
    "./floor": "./lib/floor.js",
    "./role/locale/*.json": "./locale/role/*.json",
    "./role/icon": "./icon.svg",
    "./floor/locale/*.json": "./locale/floor/*.json",
    "./floor/icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "lib/role.js",
    "lib/role-numeric-1.js",
    "lib/floor.js",
    "lib/build-manifest.json",
    "assets/**/*",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/**/*.json",
    "icon.svg",
    "README.md",
    "docs/ASSET_ADAPTATION.md",
    "docs/ROLE_RUNTIME.md",
    "docs/MODEL_EXPERIENCE.md",
    "LICENSE",
    "NOTICE",
    "licenses/**/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "rollup": "4.67.4"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
