{
  "name": "@local/dsh-financial-services",
  "version": "0.4.0-alpha.2",
  "description": "Financial Analysis and Equity Research Agent and Skill runtime for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./data": "./lib/data.js",
    "./data-contracts": "./src/data/contracts.js",
    "./review": "./lib/review.js",
    "./run": "./lib/run.js",
    "./business-task-templates/v1": "./src/business/task-templates.js",
    "./data/locale/*.json": "./locale/data/*.json",
    "./data/icon": "./icon.svg",
    "./role": "./lib/role.js",
    "./role-numeric-1": "./lib/role-numeric-1.js",
    "./role-data-1": "./lib/role-data-1.js",
    "./role-data-1/locale/*.json": "./locale/role/*.json",
    "./role-data-1/icon": "./icon.svg",
    "./role-numeric-1/locale/*.json": "./locale/role/*.json",
    "./role-numeric-1/icon": "./icon.svg",
    "./floor": "./lib/floor.js",
    "./role/locale/*.json": "./locale/role/*.json",
    "./role/icon": "./icon.svg",
    "./floor/locale/*.json": "./locale/floor/*.json",
    "./floor/icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "lib/data.js",
    "lib/review.js",
    "lib/run.js",
    "lib/role-data-1.js",
    "lib/role.js",
    "lib/role-numeric-1.js",
    "lib/floor.js",
    "lib/build-manifest.json",
    "lib/preset-patch-manifest.json",
    "assets/runtime-manifest.json",
    "assets/runtime-scope.json",
    "assets/runtime-skills/**/*",
    "assets/runtime-role-skills/**/*",
    "assets/runtime-commands/**/*",
    "assets/prompts/**/*.md",
    "assets/NOTICE.md",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/**/*.json",
    "icon.svg",
    "README.md",
    "docs/ROLE_RUNTIME.md",
    "docs/DATA_CONTRACT.md",
    "docs/FPROV01-ADAPTER-CONTRACT.md",
    "docs/FPROV01-SOURCE-MATRIX.md",
    "docs/FPROV01-NEXT-DECISIONS.md",
    "acceptance/FPROV01-BASELINE.md",
    "acceptance/FPROV01-ACCEPTANCE-REPORT.md",
    "acceptance/FPROV01-EVIDENCE/**/*",
    "acceptance/FINANCE-3A-FPROV-BASELINE.md",
    "acceptance/FINANCE-3A-FPROV-INTEGRATION-REPORT.md",
    "acceptance/FINANCE-3A-FPROV-EVIDENCE/**/*",
    "examples/ashare-adapters/**/*",
    "docs/DATA_CONTRACT_DESIGN.md",
    "docs/MCP_COMPATIBILITY.md",
    "docs/RUNTIME_SCOPE.md",
    "LICENSE",
    "NOTICE",
    "licenses/**/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "rollup": "4.67.4"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
